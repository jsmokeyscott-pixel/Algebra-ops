 ce:{text:'You draw 4 cans of 200 rounds and 3 loose belts of 50. You fire 120 on Table I. How many rounds are left?',item:{q:'4 × 200 + 3 × 50 − 120 = ?',type:'num',ans:830,sol:'Multiply before you add: 800 + 150 = 950. Then 950 − 120 = <b>830</b>.'}},
 gni:`<p>Math has a fixed order so everyone gets the same answer from the same line.</p><div class="rule"><b>Order:</b> Parentheses, Exponents, Multiply and Divide (left to right), Add and Subtract (left to right).</div><div class="rule"><b>Signed numbers:</b> same signs, add and keep the sign. Different signs, subtract and keep the sign of the bigger one. Negative × negative = positive. Subtracting a negative is adding.</div><div class="ex">3 + 4 × (2 − 5)²<br>= 3 + 4 × (−3)²<br>= 3 + 4 × 9<br>= 3 + 36 = 39</div><p>Watch this one: −3² = −9 (exponent first), but (−3)² = 9.</p>`,
 dev:'Every formula you plug numbers into, from load plans to link budgets to fuel forecasts, runs on this order. Most “calculator errors” are really order-of-operations errors.',
 gen(d){const a=ri(-9,9),b=ri(2,9),c=nz(-6,6),e=ri(2,5),k=nz(-6,6);
  const f=[()=>({q:`Evaluate: ${N(a)} + ${b} × ${P(c)}`,ans:a+b*c,sol:`Multiply first: ${b} × ${P(c)} = ${N(b*c)}. Then ${N(a)} + ${P(b*c)} = <b>${N(a+b*c)}</b>.`}),
   ()=>({q:`Evaluate: (${N(a)} − ${b}) × ${P(c)} + ${e}²`,ans:(a-b)*c+e*e,sol:`Parentheses: ${N(a)} − ${b} = ${N(a-b)}. Exponent: ${e}² = ${e*e}. Multiply: ${P(a-b)} × ${P(c)} = ${N((a-b)*c)}. Add: <b>${N((a-b)*c+e*e)}</b>.`}),
   ()=>({q:`Evaluate: ${N(a)} − ${P(e*k)} ÷ ${e} × ${b}`,ans:a-k*b,sol:`÷ and × go left to right: ${P(e*k)} ÷ ${e} = ${N(k)}, then × ${b} = ${N(k*b)}. Then ${N(a)} − ${P(k*b)} = <b>${N(a-k*b)}</b>.`})];
  return {...pick(d===1?[f[0],f[2]]:f)(),type:'num'};}},
{id:'frac',title:'Fractions',bloom:'Apply',
