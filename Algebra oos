<script>
/* ===== helpers ===== */
const ri=(a,b)=>Math.floor(Math.random()*(b-a+1))+a;
const nz=(a,b)=>{let n;do{n=ri(a,b)}while(n===0);return n};
const pick=a=>a[Math.floor(Math.random()*a.length)];
const gcd=(a,b)=>{a=Math.abs(a);b=Math.abs(b);while(b){[a,b]=[b,a%b]}return a||1};
const M='−';
const N=n=>n<0?M+(-n):''+n;
const P=n=>n<0?'('+M+(-n)+')':''+n;
const sg=n=>n===0?'':(n<0?' '+M+' '+(-n):' + '+n);
const SUP={'0':'⁰','1':'¹','2':'²','3':'³','4':'⁴','5':'⁵','6':'⁶','7':'⁷','8':'⁸','9':'⁹','-':'⁻'};
const sup=n=>String(n).split('').map(c=>SUP[c]||c).join('');
function poly(cs,v='x'){const deg=cs.length-1;let s='';cs.forEach((c,i)=>{if(!c)return;const p=deg-i;const vv=p===0?'':p===1?v:v+sup(p);const m=Math.abs(c);const body=(m===1&&p>0?'':m)+vv;s+=s===''?(c<0?M:'')+body:(c<0?' '+M+' ':' + ')+body;});return s||'0';}
function term(c,v,first){if(!c)return '';const m=Math.abs(c);const body=(m===1?'':m)+v;return first?(c<0?M:'')+body:(c<0?' '+M+' ':' + ')+body;}
function eqn(cs,vs,rhs){let s='';cs.forEach((c,i)=>{if(!c)return;s+=term(c,vs[i],s==='');});return (s||'0')+' = '+N(rhs);}
function frac(n,d){if(d<0){n=-n;d=-d}const g=gcd(n,d);n/=g;d/=g;return d===1?N(n):N(n)+'/'+d;}
const cstr=c=>c===1?'':c===-1?M:N(c);
function mc(opts,correct){const arr=opts.map((o,i)=>({o,c:i===correct}));for(let i=arr.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[arr[i],arr[j]]=[arr[j],arr[i]];}return {options:arr.map(a=>a.o),ans:arr.findIndex(a=>a.c)};}
const mat=A=>`<table class="mat"><tbody>${A.map(r=>`<tr>${r.map(v=>`<td>${N(v)}</td>`).join('')}</tr>`).join('')}</tbody></table>`;
const det3=m=>m[0][0]*(m[1][1]*m[2][2]-m[1][2]*m[2][1])-m[0][1]*(m[1][0]*m[2][2]-m[1][2]*m[2][0])+m[0][2]*(m[1][0]*m[2][1]-m[1][1]*m[2][0]);
const Cnk=(n,k)=>{let r=1;for(let i=1;i<=k;i++)r=r*(n-k+i)/i;return Math.round(r)};
const fac=(a,p)=>`(${a===1?'':a===-1?'-':a}x${p<0?'-':'+'}${Math.abs(p)})`;
const r2=v=>(Math.round(v*100)/100).toFixed(2);

/* ===== expression parser ===== */
const FN={sqrt:Math.sqrt,abs:Math.abs,ln:Math.log,log:x=>Math.log10(x),sin:Math.sin,cos:Math.cos,tan:Math.tan,exp:Math.exp};
function tokenize(s){
  s=String(s).replace(/[−–]/g,'-').replace(/[×·]/g,'*').replace(/÷/g,'/').replace(/π/g,'pi').replace(/√/g,'sqrt').replace(/²/g,'^2').replace(/³/g,'^3').replace(/[\[{]/g,'(').replace(/[\]}]/g,')').replace(/\s+/g,'');
  const t=[];let i=0;
  while(i<s.length){const c=s[i];
    if(/[0-9.]/.test(c)){let j=i;while(j<s.length&&/[0-9.]/.test(s[j]))j++;const v=Number(s.slice(i,j));if(isNaN(v))throw 'That number doesn’t look right.';t.push({k:'n',v});i=j;continue;}
    if(/[a-zA-Z]/.test(c)){const m=s.slice(i).match(/^(sqrt|abs|ln|log|sin|cos|tan|exp|pi)/);if(m){const w=m[1];t.push(w==='pi'?{k:'n',v:Math.PI}:{k:'f',v:w});i+=w.length;continue;}if(c==='e'){t.push({k:'n',v:Math.E});i++;continue;}t.push({k:'v',v:c});i++;continue;}
    if('+-*/^()'.includes(c)){t.push({k:c});i++;continue;}
    throw `Unexpected “${c}”.`;
  }
  return t;
}
function parse(str){
  const t=tokenize(str);let p=0;
  if(!t.length)throw 'Enter an answer first.';
  const peek=()=>t[p],eat=k=>{if(t[p]&&t[p].k===k){p++;return true}return false};
  function expr(){let n=term();while(peek()&&(peek().k==='+'||peek().k==='-')){const op=t[p++].k;n={t:'b',op,a:n,b:term()}}return n;}
  function term(){let n=unary();for(;;){const k=peek()&&peek().k;if(k==='*'||k==='/'){p++;n={t:'b',op:k,a:n,b:unary()}}else if(k==='n'||k==='v'||k==='f'||k==='('){n={t:'b',op:'*',a:n,b:power()}}else break;}return n;}
  function unary(){if(eat('-'))return {t:'neg',a:unary()};if(eat('+'))return unary();return power();}
  function power(){const b=primary();if(eat('^'))return {t:'b',op:'^',a:b,b:unary()};return b;}
  function primary(){const tk=t[p++];if(!tk)throw 'The expression ends too early.';
    if(tk.k==='n')return {t:'n',v:tk.v};
    if(tk.k==='v')return {t:'v',v:tk.v};
    if(tk.k==='f'){let a;if(eat('(')){a=expr();if(!eat(')'))throw 'Missing a closing parenthesis.';}else a=power();return {t:'f',f:tk.v,a};}
    if(tk.k==='('){const e=expr();if(!eat(')'))throw 'Missing a closing parenthesis.';return {t:'p',a:e};}
    throw 'There’s an operator out of place.';}
  const root=expr();if(p<t.length)throw 'Something extra is at the end.';return root;
}
function ev(n,env){switch(n.t){case 'n':return n.v;case 'v':if(!(n.v in env))throw 'Unknown letter “'+n.v+'”.';return env[n.v];case 'neg':return -ev(n.a,env);case 'p':return ev(n.a,env);case 'f':return FN[n.f](ev(n.a,env));case 'b':{const a=ev(n.a,env),b=ev(n.b,env);switch(n.op){case '+':return a+b;case '-':return a-b;case '*':return a*b;case '/':return a/b;case '^':return Math.pow(a,b);}}}return NaN;}
function vars(n,s=new Set()){if(n.t==='v')s.add(n.v);for(const k of ['a','b'])if(n[k]&&typeof n[k]==='object')vars(n[k],s);return s;}
function clean(s){return String(s).replace(/%/g,'').replace(/^\s*(f\s*(\^?\s*-\s*1|⁻¹)?\s*\(\s*x\s*\)|[a-zA-Z])\s*=\s*/,'').trim();}
function numVal(s){if(!String(s).trim())throw 'Enter an answer first.';const n=parse(s);if(vars(n).size)throw 'Enter a number here, not an expression.';const v=ev(n,{});if(!isFinite(v))throw 'That doesn’t work out to a number.';return v;}
function close(v,a,tol){if(tol!=null)return Math.abs(v-a)<=tol+1e-9;return Math.abs(v-a)<=1e-6*Math.max(1,Math.abs(a));}
function uniqNums(arr,tol){const o=[];arr.forEach(v=>{if(!o.some(x=>close(x,v,tol)))o.push(v)});return o;}
function equiv(n1,n2){const vs=[...new Set([...vars(n1),...vars(n2)])];let good=0;for(let t=0;t<14&&good<6;t++){const env={};vs.forEach(v=>env[v]=0.55+Math.random()*1.9);const a=ev(n1,env),b=ev(n2,env);if(!isFinite(a)||!isFinite(b))continue;if(Math.abs(a-b)>1e-6*Math.max(1,Math.abs(a),Math.abs(b)))return false;good++;}return good>=3;}
function countF(n){if(n.t==='neg')return countF(n.a);if(n.t==='p')return 1;if(n.t==='b'&&n.op==='*')return countF(n.a)+countF(n.b);if(n.t==='b'&&n.op==='^'&&n.a.t==='p'&&n.b.t==='n')return n.b.v;return 0;}
const FLIP={'<':'>','>':'<','<=':'>=','>=':'<='};
const OPS={'<':'<','>':'>','<=':'≤','>=':'≥'};
function check(item,input){
  try{
    if(item.type==='choice')return {ok:input===item.ans};
    if(item.type==='fields'){const vals=input.map(s=>{if(!String(s).trim())throw 'Fill in every box.';return numVal(clean(s))});const wrong=item.fields.filter((f,i)=>!close(vals[i],f.ans,f.tol)).map(f=>f.label);return {ok:!wrong.length,msg:wrong.length?'Check: '+wrong.join(', ')+'.':''};}
    const raw=String(input).trim();if(!raw)throw 'Enter an answer first.';
    if(item.type==='num')return {ok:close(numVal(clean(raw)),item.ans,item.tol)};
    if(item.type==='set'){const low=raw.toLowerCase();const none=/^(none|no\b|ns$|∅|dne)/.test(low);if(!item.ans.length)return {ok:none};if(none)return {ok:false};const got=uniqNums(raw.split(/,|;|\bor\b|\band\b/i).map(s=>s.trim()).filter(Boolean).map(s=>numVal(clean(s))),item.tol);const ans=uniqNums(item.ans,item.tol);return {ok:ans.length===got.length&&ans.every(a=>got.some(g=>close(g,a,item.tol)))};}
    if(item.type==='expr'){const n=parse(clean(raw));if(!equiv(n,parse(item.ans)))return {ok:false};if(item.minF&&countF(n)<item.minF)return {ok:false,msg:'That’s equivalent, but it isn’t factored completely.'};return {ok:true};}
    if(item.type==='ineq'){const s=raw.replace(/≤/g,'<=').replace(/≥/g,'>=').replace(/=</g,'<=').replace(/=>/g,'>=').replace(/[−–]/g,'-').replace(/\s+/g,'');let m=s.match(/^([a-zA-Z])(<=|>=|<|>)(.+)$/),op,val;if(m){op=m[2];val=numVal(m[3]);}else{m=s.match(/^(.+?)(<=|>=|<|>)([a-zA-Z])$/);if(!m)throw 'Use a form like x < 4 or x >= -2.';op=FLIP[m[2]];val=numVal(m[1]);}return {ok:op===item.ans.op&&close(val,item.ans.val)};}
  }catch(e){return {err:typeof e==='string'?e:'Couldn’t read that. Check the syntax.'}}
  return {err:'Unknown question type.'};
}

